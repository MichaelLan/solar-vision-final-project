{
  "name": "solar-vision",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
